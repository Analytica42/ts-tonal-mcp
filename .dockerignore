# Dependencies and build output are produced inside the image, never copied in.
node_modules
dist

# VCS / CI metadata
.git
.gitignore
.github

# Tests and test-only tsconfig are devDependency-driven (tsx) and never shipped.
tests
tsconfig.test.json

# NOTE: package-lock.json is deliberately NOT ignored — the build stage runs
# `npm ci`, which requires it. Upstream gitignores the lockfile; ours is committed
# on the a42-deploy branch so the image builds from a pinned dependency tree.
yarn.lock

# Secrets must never enter the build context.
.env
.env.*

# Local noise
*.log
coverage
.vscode
.idea
.DS_Store
